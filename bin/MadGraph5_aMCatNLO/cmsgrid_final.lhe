<initrwgt>
<weight id="1001" MUR="1.0" MUF="1.0" PDF="325500" >  </weight>
<weightgroup name="Central scale variation" combine="envelope">
<weight id="1002" MUR="1.0" MUF="1.0" DYN_SCALE="1" PDF="325500" > dyn_scale_choice=sum pt  </weight>
<weight id="1003" MUR="1.0" MUF="1.0" DYN_SCALE="2" PDF="325500" > dyn_scale_choice=HT  </weight>
<weight id="1004" MUR="1.0" MUF="1.0" DYN_SCALE="3" PDF="325500" > dyn_scale_choice=HT/2  </weight>
<weight id="1005" MUR="1.0" MUF="1.0" DYN_SCALE="4" PDF="325500" > dyn_scale_choice=sqrts  </weight>
<weight id="1006" MUR="2.0" MUF="1.0" PDF="325500" > MUR=2.0  </weight>
